# Copy to .env locally. Never commit secrets.

# GCP / compiler
GOOGLE_CLOUD_PROJECT=oracle-knowledge-platform
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Required for every Firestore export (enterprise silo boundary)
OKP_TENANT_ID=acme
OKP_SILO_ID=default

# Studio auth (Firebase Auth OIDC/SAML provider ID)
# VITE_OKP_AUTH_PROVIDER=oidc.your-provider
# VITE_SEARCH_API_URL=

# Studio must read the same tenant/silo the compiler published to
# VITE_OKP_TENANT_ID=acme
# VITE_OKP_SILO_ID=default

# Optional closed-beta model key (browser settings preferred)
# VITE_GEMINI_API_KEY=
