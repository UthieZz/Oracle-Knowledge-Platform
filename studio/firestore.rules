rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /meta/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /platforms/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /conversations/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /knowledgeObjects/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /entities/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /attachments/{document} {
      allow read: if true;
      allow write: if false;
    }
  }
}
